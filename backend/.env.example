NODE_ENV=development
PORT=3000

# --- Option A: Neon (cloud) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require

# --- Option B: local PostgreSQL (comment out Option A and use these) ---
# The backend picks the standard `pg` driver automatically for non-Neon hosts.
# DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/pcbuilderstore
# DIRECT_URL=postgresql://postgres:PASSWORD@localhost:5432/pcbuilderstore

CORS_ORIGINS=http://localhost:5173
