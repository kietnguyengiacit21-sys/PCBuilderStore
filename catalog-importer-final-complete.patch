+    @Test
+    void firstActualImageBecomesPrimaryWhenEarlierImageSlotIsBlank() throws IOException {
+        String catalogCsv = Files.readString(
+                Path.of("..", "catalog-import-150-products.csv").toAbsolutePath().normalize(),
