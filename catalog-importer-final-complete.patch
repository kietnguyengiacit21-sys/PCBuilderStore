+    static Matcher validateDisposableJdbcUrl(String url) {
+        Matcher matcher = url == null ? null : ALLOWED_DATABASE_URL.matcher(url);
+        if (matcher == null || !matcher.matches()) {
+            throw new IllegalStateException(
+                    "PostgreSQL importer tests require a local JDBC URL without query parameters and "
+                            + "a disposable pcbs_import_it_<uuid> database; "
+                            + "pc_builder_store_dev and pc_builder_store_it are prohibited.");
+        }
+        String portText = matcher.group(1);
+        if (portText != null) {
+            int port = Integer.parseInt(portText);
+            if (port < 1 || port > 65535) {
+                throw new IllegalStateException("PostgreSQL importer test JDBC URL has an invalid port.");
+            }
+        }
+        return matcher;
+    }
+
+    static void validateDisposableDatabaseIdentity(
+            String expectedDatabase, String actualDatabase, String serverAddress) {
+        if (!expectedDatabase.equals(actualDatabase)
+                || "pc_builder_store_dev".equals(actualDatabase)
+                || "pc_builder_store_it".equals(actualDatabase)) {
+            throw new IllegalStateException(
+                    "PostgreSQL importer tests connected to an unexpected database; "
+                            + "only the requested pcbs_import_it_<uuid> database is allowed.");
+        }
+        if (serverAddress == null || serverAddress.isBlank()) {
+            throw new IllegalStateException("Could not verify local PostgreSQL server address.");
+        }
+        String[] parts = serverAddress.split("/", -1);
+        if (parts.length > 2 || parts[0].isBlank()) {
+            throw new IllegalStateException("Could not verify local PostgreSQL server address.");
+        }
+        String addressText = parts[0];
+        boolean ipv6 = addressText.contains(":");
+        if (ipv6 && !addressText.matches("[0-9A-Fa-f:.]+")
+                || !ipv6 && !addressText.matches("[0-9]{1,3}(?:\\.[0-9]{1,3}){3}")) {
+            throw new IllegalStateException("PostgreSQL integration tests require a numeric local server address.");
+        }
+        try {
+            InetAddress address = InetAddress.getByName(addressText);
+            if (address instanceof Inet6Address && addressText.indexOf(':') < 0) {
+                throw new IllegalStateException("Could not verify local PostgreSQL server address.");
+            }
+            if (parts.length == 2) {
+                if (!parts[1].matches("[0-9]+")) {
+                    throw new IllegalStateException("Could not verify local PostgreSQL server address.");
+                }
+                int prefix = Integer.parseInt(parts[1]);
+                if (prefix != address.getAddress().length * Byte.SIZE) {
+                    throw new IllegalStateException("PostgreSQL server address is not a single local host.");
+                }
+            }
+            if (!address.isLoopbackAddress()) {
+                throw new IllegalStateException(
+                        "PostgreSQL importer tests require a local loopback server address.");
+            }
+        } catch (UnknownHostException | NumberFormatException exception) {
+            throw new IllegalStateException("Could not verify local PostgreSQL server address.", exception);
+        }
+    }
