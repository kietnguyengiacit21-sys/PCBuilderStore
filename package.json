{
  "name": "pc-builder-store",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=20.19.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev --workspace=frontend\" \"npm:dev --workspace=backend\"",
    "build": "npm run build --workspace=frontend && npm run typecheck --workspace=backend",
    "test": "npm run test --workspace=backend",
    "db:validate": "npm run db:validate --workspace=backend",
    "db:generate": "npm run db:generate --workspace=backend",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "esbuild@0.28.2": true,
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true
  }
}
